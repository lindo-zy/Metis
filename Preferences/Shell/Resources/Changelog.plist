<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
	<dict>
		<key>version</key>
		<string>1.7.10</string>
		<key>items</key>
		<array>
			<dict>
				<key>tag</key>
				<string>新增</string>
				<key>text</key>
				<string>截图支持自定义水印，可从相册或文件导入素材，拖动调整位置、大小与不透明度。</string>
			</dict>
			<dict>
				<key>tag</key>
				<string>新增</string>
				<key>text</key>
				<string>水印作用范围可选所有截图、仅普通截图或仅套壳截图，套壳时叠加覆盖机壳与背景。</string>
			</dict>
		</array>
	</dict>
	<dict>
		<key>version</key>
		<string>1.7.9</string>
		<key>items</key>
		<array>
			<dict>
				<key>tag</key>
				<string>新增</string>
				<key>text</key>
				<string>系统动作和截图快捷链接新增文字识别、全图扫码与图片问答入口。</string>
			</dict>
		</array>
	</dict>
	<dict>
		<key>version</key>
		<string>1.7.8</string>
		<key>items</key>
		<array>
			<dict>
				<key>tag</key>
				<string>优化</string>
				<key>text</key>
				<string>改进全图扫码识别，增加二维码识别回退。</string>
			</dict>
			<dict>
				<key>tag</key>
				<string>修复</string>
				<key>text</key>
				<string>改进本地文字识别的兼容性，并在识别失败时自动重试。</string>
			</dict>
		</array>
	</dict>
	<dict>
		<key>version</key>
		<string>1.7.7</string>
		<key>items</key>
		<array>
			<dict>
				<key>tag</key>
				<string>新增</string>
				<key>text</key>
				<string>文字识别支持百度 AI Studio，可配置 Access Token 并选择飞桨 OCR 模型。</string>
			</dict>
		</array>
	</dict>
	<dict>
		<key>version</key>
		<string>1.7.5</string>
		<key>items</key>
		<array>
			<dict>
				<key>tag</key>
				<string>新增</string>
				<key>text</key>
				<string>设置新增「相册增强」分类：照片查看支持解除缩放上限，最高可放大到 16 倍。</string>
			</dict>
			<dict>
				<key>tag</key>
				<string>新增</string>
				<key>text</key>
				<string>支持跳过照片删除确认弹窗，删除不再二次确认，均可在相册增强中开启。</string>
			</dict>
		</array>
