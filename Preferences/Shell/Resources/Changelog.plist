<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
	<dict>
		<key>version</key>
		<string>1.5.7</string>
		<key>items</key>
		<array>
			<dict>
				<key>tag</key>
				<string>修复</string>
				<key>text</key>
				<string>修复锁屏有通知时充电卡片完全不显示的问题。</string>
			</dict>
			<dict>
				<key>tag</key>
				<string>优化</string>
				<key>text</key>
				<string>锁屏有通知时充电卡片自动上移到通知上方，不再遮挡通知；通知列表展开时仍自动隐藏。</string>
			</dict>
		</array>
	</dict>
	<dict>
		<key>version</key>
		<string>1.5.6</string>
		<key>items</key>
		<array>
			<dict>
				<key>tag</key>
				<string>修复</string>
				<key>text</key>
				<string>上滑输入密码时充电卡片立即隐藏，不再遮挡密码键盘。</string>
			</dict>
			<dict>
				<key>tag</key>
				<string>新增</string>
				<key>text</key>
				<string>锁屏有通知时充电卡片自动让位，通知清空后恢复显示。</string>
			</dict>
		</array>
	</dict>
	<dict>
		<key>version</key>
		<string>1.5.5</string>
		<key>items</key>
		<array>
			<dict>
				<key>tag</key>
				<string>优化</string>
				<key>text</key>
				<string>锁屏充电卡片移除近 60 秒功率曲线，卡片更紧凑，功率、电量等其余数据保持不变。</string>
			</dict>
		</array>
	</dict>
	<dict>
		<key>version</key>
		<string>1.5.4</string>
		<key>items</key>
		<array>
			<dict>
				<key>tag</key>
				<string>修复</string>
				<key>text</key>
				<string>锁屏充电卡片的近 60 秒曲线不再随功率小幅波动上下跳动，曲线高度保持稳定。</string>
			</dict>
			<dict>
				<key>tag</key>
				<string>修复</string>
				<key>text</key>
				<string>充满预估改按剩余电量和实际充电电流推算，不再显示系统给出的明显偏大的分钟数。</string>
			</dict>
		</array>
	</dict>
	<dict>
		<key>version</key>
		<string>1.5.3</string>
		<key>items</key>
		<array>
			<dict>
				<key>tag</key>
				<string>修复</string>
				<key>text</key>
				<string>修复使用景深效果壁纸时，锁屏充电卡片会被壁纸主体遮住的情况。</string>
			</dict>
			<dict>
				<key>tag</key>
				<string>优化</string>
				<key>text</key>
				<string>锁屏充电卡片底色加深，亮色壁纸上的小字更容易看清。</string>
			</dict>
		</array>
	</dict>
</array>
</plist>
